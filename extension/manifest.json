{
  "manifest_version": 3,
  "name": "MeetGuard",
  "version": "1.0.0",
  "description": "AI-powered meeting moderation extension.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}